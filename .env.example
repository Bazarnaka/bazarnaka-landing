# URL publique du site, utilisée pour les balises Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.bazarnaka.mg

# Où sont stockés les emails de la waitlist : file | brevo | resend | supabase
# « file » (défaut) écrit dans .data/waitlist.jsonl — développement uniquement.
WAITLIST_PROVIDER=file

# Brevo (implémenté). BREVO_LIST_ID est l'identifiant NUMÉRIQUE de la liste,
# visible dans Contacts > Listes.
# BREVO_API_KEY=
# BREVO_LIST_ID=

# TODO(waitlist) : les fournisseurs ci-dessous ne sont pas encore implémentés.
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
